{
    "name": "khaledhajsalem/zatca-laravel",
    "description": "A Laravel package for ZATCA e-invoicing with a built-in Telescope-style dashboard for monitoring invoices, API calls, certificates, and compliance status.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "laravel",
        "zatca",
        "e-invoicing",
        "saudi-arabia",
        "vat",
        "tax",
        "ubl",
        "dashboard"
    ],
    "authors": [
        {
            "name": "Khaled Haj Salem",
            "email": "khaledhajsalem@fastmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "khaledhajsalem/zatca-php": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "KhaledHajSalem\\ZatcaLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KhaledHajSalem\\ZatcaLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KhaledHajSalem\\ZatcaLaravel\\ZatcaServiceProvider"
            ],
            "aliases": {
                "Zatca": "KhaledHajSalem\\ZatcaLaravel\\Facades\\Zatca"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
